      },
      {
        "step_number": 4,
        "classifier": "action",
        "action": "On cart page, enter the coupon code SAVE10 and apply coupon.",
        "expected_outcome": "System validates the coupon, applies the predefined discount amount associated with the coupon code, and displays the applied coupon details. The Coupon Discount is shown as 10 in the currently selected currency, and the displayed Coupon Discount value exactly matches the expected value for the applied coupon. Product price, shipping, coupon discount, and total shall all be displayed in the selected currency."
      }
