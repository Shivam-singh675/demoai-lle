    "automationSteps": [
      {
        "step_number": 1,
        "classifier": "action",
        "action": "Navigate to http://66.220.31.130:31528/",
        "expected_outcome": "The application at http://66.220.31.130:31528/ opens successfully."
      },
      {
        "step_number": 2,
        "classifier": "action",
        "action": "As a customer, add products to the cart and open the Cart page with a subtotal at the minimum order value for a particular coupon or just above it, then enter and submit that coupon through the cart coupon flow.",
        "expected_outcome": "The system validates the minimum order value for a particular coupon, accepts the coupon only when the cart is eligible, and shows the applied coupon details on the Cart page only when the cart is eligible."
      },
      {
        "step_number": 3,
        "classifier": "action",
        "action": "Review the updated totals on the Cart page after coupon validation and discount application.",
        "expected_outcome": "The system recalculates the cart totals accurately on the Cart page after coupon validation and discount application, and any discount is prevented from exceeding the subtotal."
      },
      {
        "step_number": 4,
        "classifier": "action",
        "action": "Adjust the cart so the subtotal is below the minimum order value for a particular coupon and submit the same coupon again from the Cart page.",
        "expected_outcome": "The coupon is rejected when the cart is not eligible, the applied coupon details are not shown, and the cart totals remain unchanged."
      }
    ],
