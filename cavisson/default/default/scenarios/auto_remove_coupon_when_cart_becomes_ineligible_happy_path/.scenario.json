    "automationSteps": [
      {
        "step_number": 1.0,
        "classifier": "action",
        "action": "Navigate to http://boutique-qa.cav-test.com:31528",
        "expected_outcome": "The application loads successfully from http://boutique-qa.cav-test.com:31528."
      },
      {
        "step_number": 2.0,
        "classifier": "action",
        "action": "Add products and proceed to the Cart page so the cart subtotal satisfies the coupon minimum order amount, then apply a valid coupon on the Cart page.",
        "expected_outcome": "The valid coupon is applied on the Cart page for a cart subtotal that satisfies the coupon minimum order amount, and the cart shows discounted totals."
      },
      {
        "step_number": 3.0,
        "classifier": "action",
        "action": "Update the cart so that the product subtotal before shipping falls below the coupon eligibility threshold.",
        "expected_outcome": "The system revalidates the applied coupon after the cart change, removes the coupon automatically if cart becomes ineligible, recalculates the cart and order totals without the discount, and updates the cart UI to show that the coupon is no longer applied."
      }
    ],
