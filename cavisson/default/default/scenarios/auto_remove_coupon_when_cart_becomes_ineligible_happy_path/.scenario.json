  },
  "description": "Verify that after a customer applies a valid coupon on the Cart page for a cart subtotal that satisfies the coupon minimum order amount, updating the cart so that the product subtotal before shipping falls below the coupon eligibility threshold causes the system to revalidate the coupon, remove it automatically, recalculate totals without the discount, and update the cart UI to show that the coupon is no longer applied.",
  "priority": "critical",
  "preTest": [],
  "postTest": [],
  "agenticInfo": {
    "applicationConfig": {
      "authentication_prompt": "",
      "applicationUrl": "http://boutique-qa.cav-test.com:31528",
