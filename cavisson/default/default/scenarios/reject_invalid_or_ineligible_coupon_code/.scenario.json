        "step_number": 1.0,
        "classifier": "action",
        "action": "Navigate to http://66.220.31.130:31528/",
        "expected_outcome": "The application loads successfully at http://66.220.31.130:31528/."
      },
      {
        "step_number": 2.0,
        "classifier": "action",
        "action": "Add an available product to the cart and open the cart or checkout area where a coupon code can be entered.",
        "expected_outcome": "The cart or checkout view is displayed with visible cart and order totals before applying any coupon code."
      },
      {
        "step_number": 3.0,
        "classifier": "action",
        "action": "Record the current cart and order totals, then enter an invalid or ineligible coupon code and complete the normal coupon submission flow available in the UI.",
        "expected_outcome": "The system validates the coupon against supported coupons and subtotal-before-shipping eligibility rules, does not apply any discount when the coupon is invalid or ineligible, keeps cart and order totals unchanged, handles the invalid entry gracefully in the UI, and clearly indicates that the coupon was not applied."
      }
