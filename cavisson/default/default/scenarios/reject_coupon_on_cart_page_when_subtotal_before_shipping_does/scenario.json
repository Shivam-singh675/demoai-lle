    "automationSteps": [
      {
        "step_number": 1,
        "classifier": "action",
        "action": "Navigate to http://boutique-qa.cav-test.com:31528",
        "expected_outcome": "The application home page loads successfully."
      },
      {
        "step_number": 2,
        "classifier": "action",
        "action": "Browse products, add products to the cart, and open the Cart page with a product subtotal before shipping at or below 50 and near coupon thresholds",
        "expected_outcome": "The customer reaches the Cart page and the product subtotal before shipping is visible for coupon validation."
      },
      {
        "step_number": 3,
        "classifier": "action",
        "action": "On the Cart page, enter the supported coupon code \"SAVE10\" using the coupon field and complete the coupon validation flow available on the Cart page",
        "expected_outcome": "The system validates whether the minimum order amount is met based on the subtotal before shipping, rejects the coupon because \"SAVE10\" applies only for orders over 50, does not show applied coupon details because the cart is not eligible, and the cart totals remain unchanged on the Cart page. All validations remain on the Cart page and no navigation to Checkout or Order Confirmation occurs."
      }
    ],
