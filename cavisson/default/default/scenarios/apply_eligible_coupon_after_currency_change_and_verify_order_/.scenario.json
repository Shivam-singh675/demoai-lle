    "automationSteps": [
      {
        "step_number": 1.0,
        "classifier": "action",
        "action": "Navigate to http://boutique-qa.cav-test.com:31528",
        "expected_outcome": "The application opens successfully."
      },
      {
        "step_number": 2.0,
        "classifier": "action",
        "action": "On the Home page, use the existing website option to change the currency to a different available currency",
        "expected_outcome": "The Home page updates to the selected currency and product pricing is shown in the chosen currency."
      },
      {
        "step_number": 3.0,
        "classifier": "action",
        "action": "From the Home page, select one or more products, navigate to the Product Details Page (PDP), and add products such that the cart total meets the eligibility criteria for applying a coupon",
        "expected_outcome": "The selected products are added to the cart and the cart total meets the eligibility criteria for applying a coupon in the selected currency."
      },
      {
        "step_number": 4.0,
        "classifier": "action",
        "action": "Navigate to the Cart page and apply an eligible coupon",
        "expected_outcome": "The system validates the coupon, applies the discount, and displays the applied coupon details, discount amount, and updated cart totals in the selected currency on the Cart page."
      },
      {
        "step_number": 5.0,
        "classifier": "action",
        "action": "Click Place Order to proceed to the Order Confirmation page",
        "expected_outcome": "The Order Confirmation page opens and displays the same applied coupon details along with the calculated discount amount in the selected currency."
      }
    ],
