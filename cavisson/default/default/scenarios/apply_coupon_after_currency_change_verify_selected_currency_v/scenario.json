      },
      {
        "step_number": 4,
        "classifier": "action",
        "action": "On cart page, enter coupon code SAVE10 and complete the cart coupon submission flow.",
        "expected_outcome": "System validates the coupon, applies the discount, and displays the applied coupon details. Coupon Discount, shipping, and total are displayed in the selected currency, SAVE10 always represents a discount of 10 in the currently selected currency, the system applies the predefined discount amount associated with the coupon code, and the displayed Coupon Discount value exactly matches the expected value for the applied coupon."
      }
    ],
