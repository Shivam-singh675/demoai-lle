          "Feature=Coupon Validation, SubFeature=Valid Coupon Application On Cart And Initial Order Confirmation, Validation=true, CartUpdate=true, Navigation=true, Source=JIRA, SourceRef=DT-143, UserStory=Apply a valid coupon on the Cart page and recalculate totals, Epic=CouponFeatureAI, app=boutique, feature=checkout, testsuite=validate_coupon_is_working_for_all_currencies"
