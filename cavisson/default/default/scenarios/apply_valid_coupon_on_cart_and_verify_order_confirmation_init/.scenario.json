  "description": "Verify that a customer can add products from the Home page, reach the minimum order amount required for applying a coupon, apply a valid coupon code on the Cart page, see recalculated totals and coupon details in the cart UI, and then verify the applied coupon details and discount amount on the initial Order Confirmation page load after clicking Place Order.",
  "priority": "critical",
  "preTest": [],
  "postTest": [],
  "agenticInfo": {
    "applicationConfig": {
      "authentication_prompt": "",
      "applicationUrl": "http://boutique-qa.cav-test.com:31528",
      "uploadDirectories": []
    },
    "uploadId": "",
    "automationSteps": [
      {
        "step_number": 1.0,
        "classifier": "action",
        "action": "Navigate to http://boutique-qa.cav-test.com:31528",
        "expected_outcome": "The application opens successfully."
      },
      {
        "step_number": 2.0,
        "classifier": "action",
        "action": "From the Home page, select one or more products and add them to the cart so that the cart subtotal meets the minimum order amount required for applying a coupon, then navigate to the Cart page",
        "expected_outcome": "The Cart page opens and shows the selected products with a product subtotal that meets the minimum order amount required for applying a coupon."
      },
      {
        "step_number": 3.0,
        "classifier": "action",
        "action": "On the Cart page, enter the valid coupon code \"SAVE10\" and complete the coupon application using the page's documented coupon entry flow",
        "expected_outcome": "The system validates coupon eligibility based on the product subtotal before shipping, applies the appropriate discount, ensures the discount does not exceed the subtotal, recalculates the cart totals, and displays the applied coupon details and updated discount amount in the Cart page UI."
      },
      {
        "step_number": 4.0,
        "classifier": "action",
        "action": "Click \"Place Order\" to proceed to the \"Order Confirmation page\"",
        "expected_outcome": "On the initial navigation to the \"Order Confirmation page\", the system displays the applied coupon details along with the discount amount."
      }
    ],
    "source": {
