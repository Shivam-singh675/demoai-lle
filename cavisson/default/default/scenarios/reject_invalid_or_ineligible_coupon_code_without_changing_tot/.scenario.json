        "classifier": "action",
        "action": "Navigate to http://66.220.31.130:31528/",
        "expected_outcome": "The application at http://66.220.31.130:31528/ opens successfully."
      },
      {
        "step_number": 2.0,
        "classifier": "action",
        "action": "Proceed as a customer to the cart or checkout area where coupon code entry and cart and order totals are visible.",
        "expected_outcome": "The customer can view the coupon code entry area along with the current cart and order totals before applying any coupon."
      },
      {
        "step_number": 3.0,
        "classifier": "action",
        "action": "Enter an invalid or ineligible coupon code and complete the coupon submission flow.",
        "expected_outcome": "The system validates the coupon against supported coupons and subtotal-before-shipping eligibility rules, does not apply any discount when the coupon is invalid or ineligible, keeps cart and order totals unchanged, handles the invalid entry gracefully in the UI, and clearly indicates that the coupon was not applied."
      }
