  $token: String!
  $release: String
  $enableContactCenter: Boolean
  $userIdentityToken: String
  $loadDemoConfig: Boolean = false
  $windowId: String
  $locale: String
) {
  embedBotByToken(token: $token, release: $release, fullscreen: false, enableContactCenter: $enableContactCenter, userIdentityToken: $userIdentityToken, windowId: $windowId, locale: $locale) {
    __typename
    ...embedChatFragment
    ... on Node {
      __isNode: __typename
      id
    }
  }
}

fragment embedChatFragment on EmbedBotResult {
  __isEmbedBotResult: __typename
  ... on EmbedBot {
    __typename
    token
    releaseHash
    brand {
      botName
      chatStyle
      logoSVG
      sendButtonSVG
      sendButtonDisabledSVG
      greetingMessage
      agentTransferWaitingMessage
      agentTransferQueueSizeMessage
      agentTransferQueueNextMessage
      agentTransferEstimatedWaitMessage
      agentTransferAverageWaitMessage
      showAgentTransferWaitingMessage
      agentTransferQueueNameMessage
      agentJoinedMessage
      agentLeftMessage
      errorMessage
      canRenderMessageImages
      inactivityMessage
      disclosure
      inputPlaceholder
      conversationEndedMessage
      logoIncludesAgentName
      dimensions {
        width
        height
        maxHeight
      }
      voiceDisclosure
      textStreamStyle {
        delayMs
        fadeIn
      }
      showTimestamps
      showBotName
      showAvatars
      agentAvatarURL
      messageLabelPlacement
      textDirection
      uiStrings
      agentDisabledMessage
      surveyPrompt
      surveyNegativeFeedback
      surveyNeutralFeedback
      surveyPositiveFeedback
    }
    contactCenterConfig {
      contactCenterEnabled
      customerCanSendAfterAgentLeave
    }
    issueCategories {
      id
      label
    }
    embedConfig {
      attachmentsStyle
      textConfig {
        enabledEvents
        inactivityTimeoutSeconds
        chatInputCharacterLimit
        clientStartEventMaxFreezeMs
        useLegacyClientEventSendBehavior
      }
    }
    webBuildToken
    webCSSToken
    markdownLinksEnabled
    additionalMarkdownLinkProtocols
    turnstileSiteKey
    windowId
    windowToken
    serverWindowPropagationEnabled
    webKeyboardAvoidanceEnabled
    embedDemoConfig @include(if: $loadDemoConfig) {
      enabled
      phoneNumber
    }
  }
  ... on EmbedBotError {
    __typename
    message
    code
  }
  ... on EmbedBotDisabled {
    __typename
    agentDisabledMessage
  }
}
