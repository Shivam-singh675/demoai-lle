  $token: String!
  $release: String
  $enableContactCenter: Boolean
  $userIdentityToken: String!
  $windowId: String
) {
  embedBotByToken(token: $token, release: $release, enableContactCenter: $enableContactCenter, userIdentityToken: $userIdentityToken, windowId: $windowId) {
    __typename
    ... on EmbedBot {
      __typename
      windowId
      ...botConversationsFragment_28PXD0
    }
    ... on EmbedBotError {
      __typename
      message
    }
    ... on EmbedBotDisabled {
      __typename
      agentDisabledMessage
    }
    ... on Node {
      __isNode: __typename
      id
    }
  }
}

fragment botConversationsFragment_28PXD0 on EmbedBot {
  logs(userIdentityToken: $userIdentityToken, first: 50) {
    edges {
      node {
        id
        encryptionKey
        firstUserMessageText
        lastMessageAt
        lastSeenAt
        hasEnded
        __typename
      }
      cursor
    }
    tokenError
    pageInfo {
      endCursor
      hasNextPage
    }
  }
  id
}
