    "automationSteps": [
      {
        "step_number": 1.0,
        "classifier": "action",
        "action": "Navigate to http://boutique-qa.cav-test.com:31528",
        "expected_outcome": "The application home page opens successfully."
      },
      {
        "step_number": 2.0,
        "classifier": "action",
        "action": "Click a product from home page, add the product to cart, and open the Cart page",
        "expected_outcome": "The selected product is added to cart and the Cart page is displayed with cart subtotal and order totals visible before coupon entry."
      },
      {
        "step_number": 3.0,
        "classifier": "action",
        "action": "Enter a coupon code that does not meet the minimum order amount on the Cart page and submit it through the cart coupon flow",
        "expected_outcome": "The system validates the coupon against supported coupons and subtotal-before-shipping eligibility rules, rejects the coupon because it does not meet the minimum order amount, does not apply any discount, keeps cart and order totals unchanged, handles the invalid entry gracefully in the UI, and clearly indicates that the coupon was not applied."
      }
    ],
