    "uploadId": "",
    "automationSteps": [
      {
        "step_number": 1.0,
        "classifier": "action",
        "action": "Navigate to http://boutique-qa.cav-test.com:31528",
        "expected_outcome": "The application home page loads successfully."
      },
      {
        "step_number": 2.0,
        "classifier": "action",
        "action": "Browse products, add products to the cart, and open the Cart page with a product subtotal before shipping over 50 and near coupon thresholds",
        "expected_outcome": "The customer reaches the Cart page and the product subtotal before shipping is visible and eligible for validation against supported coupon codes \"SAVE10\", \"SAVE50\", or \"SAVE100\"."
      },
      {
        "step_number": 3.0,
        "classifier": "action",
        "action": "On the Cart page, enter the supported coupon code \"SAVE10\" using the coupon field and complete the coupon validation flow available on the Cart page",
        "expected_outcome": "The system validates whether the minimum order amount is met based on the subtotal before shipping, applies \"SAVE10\" only for orders over 50, shows the applied coupon details because the cart is eligible, prevents any discount from exceeding the subtotal, and recalculates the cart totals accurately on the Cart page after coupon validation and discount application."
      }
    ],
