  "agenticInfo": {
    "applicationConfig": {
      "authentication_prompt": "",
      "applicationUrl": "http://boutique-qa.cav-test.com:31528",
      "uploadDirectories": []
    },
    "uploadId": "",
    "automationSteps": [
      {
        "step_number": 1.0,
        "classifier": "action",
        "action": "Navigate to http://boutique-qa.cav-test.com:31528",
        "expected_outcome": "The application opens successfully."
      },
      {
        "step_number": 2.0,
        "classifier": "action",
        "action": "From the Home page, select one or more products and add them to the cart without reaching the minimum order amount required for applying a coupon, then navigate to the Cart page",
        "expected_outcome": "The Cart page opens and shows the selected products with a product subtotal below the minimum order amount required for applying a coupon."
      },
      {
        "step_number": 3.0,
        "classifier": "action",
        "action": "On the Cart page, enter the valid coupon code \"SAVE50\" and complete the coupon application using the page's documented coupon entry flow",
        "expected_outcome": "The system validates coupon eligibility based on the product subtotal before shipping and rejects applying the coupon because the minimum order amount required for applying a coupon is not met; no applied coupon details or updated discount amount are shown in the Cart page UI, and the cart totals remain without the coupon discount."
      }
    ],
