      },
      {
        "step_number": 2,
        "classifier": "action",
        "action": "Proceed as a customer from the storefront and add products until the cart subtotal is at or above the minimum order value for a particular coupon, then open the Cart page.",
        "expected_outcome": "The customer reaches the Cart page with a subtotal that is eligible for coupon validation at the required subtotal boundary."
      },
      {
        "step_number": 3,
        "classifier": "action",
        "action": "Enter a valid coupon for the eligible cart and submit the coupon on the Cart page.",
        "expected_outcome": "The system validates the minimum order value for a particular coupon, applies the coupon only because the cart is eligible, prevents any discount from exceeding the subtotal, recalculates the cart totals accurately on the Cart page after coupon validation and discount application, and shows the applied coupon details."
      }
    ],
